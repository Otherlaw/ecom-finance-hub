{
  "manifest_version": 3,
  "name": "ECOM Finance - Margem ML",
  "version": "1.0.0",
  "description": "Visualize a margem de contribuicao das suas vendas diretamente no Mercado Livre",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://www.mercadolivre.com.br/*",
    "https://bwfbozwyqujlykgaueez.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.mercadolivre.com.br/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
