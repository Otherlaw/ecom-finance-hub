# ================================================
# NFe Worker - Variaveis de Ambiente
# ================================================

# SUPABASE (Obrigatorio)
# URL do projeto Supabase
SUPABASE_URL=https://bwfbozwyqujlykgaueez.supabase.co

# ================================================
# SEGURANCA (Obrigatorio)
# ================================================

# Token para autenticar chamadas ao nfe-ingest e nfe-worker-proxy
# Deve ser o mesmo configurado como secret WORKER_INGEST_TOKEN no Supabase
WORKER_INGEST_TOKEN=your-secure-token-here

# Chave mestra para descriptografar certificados A1
# Formato: string de 32 caracteres ou hex de 64 caracteres
# Deve ser o mesmo configurado como secret CERT_MASTER_KEY no Supabase
# NUNCA compartilhe esta chave!
CERT_MASTER_KEY=your-32-character-encryption-key

# ================================================
# SEFAZ (Obrigatorio)
# ================================================

# Ambiente da SEFAZ: production ou homologation
# production = ambiente real
# homologation = ambiente de testes
SEFAZ_ENV=production

# ================================================
# SERVIDOR (Opcional)
# ================================================

# Porta do servidor HTTP (Render define automaticamente)
PORT=8080
